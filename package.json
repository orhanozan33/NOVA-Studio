  "license":"UNLICENSED",
  "scripts":{"start":"electron .","dist:mac":"electron-builder --mac dmg --x64","dist:mac:arm":"electron-builder --mac dmg --arm64"},
  "devDependencies":{"electron":"^39.0.0","electron-builder":"^26.0.12"},
  "build":{
    "appId":"tech.nova.desktop",
